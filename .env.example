# Reference only: these examples are not loaded automatically.
# Set values in PowerShell ($env:NAME = 'value') or your service configuration.
NAVA_APP_NAME=NAVA
NAVA_TIME_ZONE=Asia/Kuala_Lumpur
NAVA_ALLOWED_HOSTS=127.0.0.1,localhost
NAVA_DEBUG=0
# Optional absolute directory; default is .runtime below the project root.
# NAVA_DATA_DIR=C:\Users\YourName\NAVA Data
# Optional externally managed secret. Omit to use setup-generated private secret.key.
# NAVA_SECRET_KEY=
# Enable only behind a correctly configured HTTPS reverse proxy.
NAVA_HTTPS=0
